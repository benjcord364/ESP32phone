        wxLo[i] = doc["daily"]["temperature_2m_min"][i] | 0.0f;
      }
      wxValid = true;
    } else wxError = "Data error";
  } else if (code > 0) wxError = "HTTP " + String(code);
  else wxError = http.errorToString(code);
  http.end();
  return wxValid;
}

