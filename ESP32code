void clockTick() {
  if (clockTab == 0) {
    struct tm ti;
    if (!getLocalTime(&ti, 0)) return;
    if (ti.tm_sec != clkLastSec) {
      clkLastSec = ti.tm_sec;
      if (ti.tm_min != clkLastMin) {
        clkLastMin = ti.tm_min;
        drawClock(0);
      } else {
        updateAnalog();
      }
    }
  } else if (clockTab == 1) {
    if (timerDone && millis() - timerDoneAt < 20000) {
      if (millis() - timerLastFlash >= 500) {
        timerLastFlash = millis();
        timerFlash = !timerFlash;
        drawClock(0);
      }
    } else if (timerDone && timerFlash) {
      timerFlash = false;
      drawClock(0);
    } else if (timerRunning) {
      long rs = (timerRemainingMs() + 999) / 1000;
      if (rs != lastTimerSec) {
        lastTimerSec = rs;
        drawTimerLive();
      }
    }
  } else {
    if (swRunning) drawSwLive();
  }
}

void handleClockTouch(int tx, int ty) {
  // tabs
  if (ty >= 56 && ty < 96) {
    int t = (tx - 12) / 99;
    if (t < 0) t = 0;
    if (t > 2) t = 2;
    if (t != clockTab) {
      clockTab = t;
      clkLastSec = -1;
      clkLastMin = -1;
      lastTimerSec = -1;
      timerFlash = false;
      drawClock(0);
    }
    return;
  }

  if (clockTab == 1) {
    const long adjDelta[4] = {-60, -10, 10, 60};
    const long preSec[4] = {60, 300, 600, 1800};
    int col = (tx - 12) / 76;
    bool inCol = (tx >= 12 && col >= 0 && col < 4 && (tx - 12) % 76 < 68);

    if (ty >= 214 && ty < 254 && inCol) {
      if (!timerRunning) {
        timerSetSec = constrain(timerSetSec + adjDelta[col], 10L, 5999L);
        timerRemainMs = timerSetSec * 1000;
        timerDone = false;
        timerFlash = false;
        drawClock(0);
      }
    } else if (ty >= 264 && ty < 300 && inCol) {
      if (!timerRunning) {
        timerSetSec = preSec[col];
        timerRemainMs = timerSetSec * 1000;
        timerDone = false;
        timerFlash = false;
        drawClock(0);
      }
    } else if (ty >= 322 && ty < 382) {
      if (tx < 160) {                                   // Reset
        timerRunning = false;
        timerDone = false;
        timerFlash = false;
        timerRemainMs = timerSetSec * 1000;
      } else {                                          // Start / Pause / Resume
        if (timerRunning) {
          timerRemainMs = timerRemainingMs();
          timerRunning = false;
        } else {
          if (timerDone || timerRemainMs <= 0) {
            timerDone = false;
            timerFlash = false;
            timerRemainMs = timerSetSec * 1000;
          }
          timerEndMs = millis() + timerRemainMs;
          timerRunning = true;
          lastTimerSec = -1;
        }
      }
      drawClock(0);
    }
  } else if (clockTab == 2) {
    if (ty >= 215 && ty < 271) {
      if (tx >= 168) {                                  // Start / Stop
        if (swRunning) {
          swAccum += millis() - swStartMs;
          swRunning = false;
        } else {
          swStartMs = millis();
          swRunning = true;
        }
      } else if (tx < 160) {                            // Lap / Reset
        if (swRunning) {
          if (swLapCount < 20) swLaps[swLapCount++] = swElapsed();
        } else {
          swAccum = 0;
          swLapCount = 0;
        }
      }
      drawClock(0);
    }
  }
}

