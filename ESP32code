  tft.setTextColor(subColor);
  tft.drawString("Swipe up from here to exit", 160, 460, 1);
  snDrawHeader();
}

void snPlaceFood() {
  for (int t = 0; t < 300; t++) {
    int x = random(SN_COLS), y = random(SN_ROWS);
    bool ok = true;
    for (int i = 0; i < snLen; i++) {
      if (snX[i] == x && snY[i] == y) { ok = false; break; }
    }
    if (ok) { snFoodX = x; snFoodY = y; return; }
  }
  for (int y = 0; y < SN_ROWS; y++) {
    for (int x = 0; x < SN_COLS; x++) {
      bool ok = true;
      for (int i = 0; i < snLen; i++) {
        if (snX[i] == x && snY[i] == y) { ok = false; break; }
      }
      if (ok) { snFoodX = x; snFoodY = y; return; }
    }
  }
  snFoodX = -1;   // board is full
}

void snakeNewGame(bool start) {
  snLen = 3;
  for (int i = 0; i < 3; i++) {
    snX[i] = 8 - i;
    snY[i] = 9;
  }
  snDx = 1; snDy = 0; snNx = 1; snNy = 0;
  snScore = 0;
  snPlaceFood();
  snDrawBoard();
  snLast = millis();
  if (start) {
    snState = SN_PLAY;
  } else {
    snState = SN_READY;
    tft.fillRoundRect(50, 170, 220, 130, 18, cardColor);
    tft.setTextDatum(lgfx::middle_center);
    tft.setTextColor(textColor);
    tft.drawString("Snake", 160, 205, 4);
    tft.setTextColor(accentColor);
    tft.drawString("Tap to start", 160, 245, 2);
    tft.setTextColor(subColor);
    tft.drawString("Then swipe to steer", 160, 270, 2);
  }
}

void snakeOver() {
  snState = SN_DEAD;
  snDeadAt = millis();
  if (snScore > snBest) {
    snBest = snScore;
    preferences.putInt("best", snBest);
  }
  snDrawHeader();
  tft.fillRoundRect(50, 170, 220, 130, 18, cardColor);
  tft.setTextDatum(lgfx::middle_center);
  tft.setTextColor(textColor);
  tft.drawString("Game Over", 160, 202, 4);
  tft.drawString("Score " + String(snScore) + "   Best " + String(snBest), 160, 240, 2);
  tft.setTextColor(accentColor);
  tft.drawString("Tap to play again", 160, 276, 2);
}

void snakeTap() {
  if (snState == SN_READY) {
    snState = SN_PLAY;
    snDrawBoard();            // clears the start card
    snLast = millis();
  } else if (snState == SN_DEAD) {
    if (millis() - snDeadAt > 500) snakeNewGame(true);
  }
}

void snakeSwipe(int tx, int ty) {
  int dx = tx - snSwipeX, dy = ty - snSwipeY;
  if (abs(dx) < 18 && abs(dy) < 18) return;
  int ndx = 0, ndy = 0;
  if (abs(dx) > abs(dy)) ndx = (dx > 0) ? 1 : -1;
  else ndy = (dy > 0) ? 1 : -1;
  if (!(ndx == -snDx && ndy == -snDy)) {   // can't reverse into yourself
    snNx = ndx;
    snNy = ndy;
  }
  snSwipeX = tx;
  snSwipeY = ty;
}

void snakeStep() {
  if (snState != SN_PLAY) return;
  int iv = 150 - snScore * 3;
  if (iv < 75) iv = 75;
  if (millis() - snLast < (unsigned long)iv) return;
  snLast = millis();

  snDx = snNx;
  snDy = snNy;
  int nx = snX[0] + snDx, ny = snY[0] + snDy;
  if (nx < 0 || nx >= SN_COLS || ny < 0 || ny >= SN_ROWS) { snakeOver(); return; }

  bool eat = (nx == snFoodX && ny == snFoodY);
  int checkLen = eat ? snLen : snLen - 1;   // the tail moves away unless we grow
  for (int i = 0; i < checkLen; i++) {
    if (snX[i] == nx && snY[i] == ny) { snakeOver(); return; }
  }

  int tailX = snX[snLen - 1], tailY = snY[snLen - 1];
  if (eat) snLen++;
  memmove(&snX[1], &snX[0], snLen - 1);
  memmove(&snY[1], &snY[0], snLen - 1);
  snX[0] = nx;
  snY[0] = ny;

  if (!eat) snCell(tailX, tailY, snBg(tailX, tailY));
  snDrawBody(snX[1], snY[1]);
  snDrawHead(nx, ny);

  if (eat) {
    snScore++;
    snDrawHeader();
    snPlaceFood();
    if (snFoodX < 0) { snakeOver(); return; }
    snDrawFood();
  }
}

