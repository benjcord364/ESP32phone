  else if (c == 45 || c == 48) { top = Col{120, 130, 145}; bot = Col{175, 182, 192}; }
  else if ((c >= 71 && c <= 77) || c == 85 || c == 86) { top = Col{120, 145, 180}; bot = Col{205, 220, 238}; }
  else if (c >= 95) { top = Col{38, 38, 68}; bot = Col{92, 84, 124}; }
  else { top = Col{58, 76, 108}; bot = Col{110, 128, 158}; }
}

String wxDayName(const String &date) {
  int y = date.substring(0, 4).toInt();
  int m = date.substring(5, 7).toInt();
  int d = date.substring(8, 10).toInt();
  if (m < 1 || m > 12) return "---";
  static const int t[] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};
  if (m < 3) y -= 1;
  int dow = (y + y / 4 - y / 100 + y / 400 + t[m - 1] + d) % 7;
  const char *names[] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
  return String(names[dow]);
}

bool wxDownload() {
  if (!wifiConnected) { wxValid = false; wxError = "No WiFi connection"; return false; }
