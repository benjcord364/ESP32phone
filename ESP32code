// CALCULATOR
String calcCur = "0";
String calcExpr = "";
double calcAcc = 0;
char calcOp = 0;
bool calcFresh = true;
bool calcErr = false;

const char* CALC_KEYS[5][4] = {
  {"AC", "+/-", "%", "/"},
  {"7", "8", "9", "*"},
  {"4", "5", "6", "-"},
  {"1", "2", "3", "+"},
  {"0", "0", ".", "="}
};

String calcFmt(double v) {
  if (isnan(v) || isinf(v)) return "Error";
  if (v == 0) return "0";
  char b[32];
  snprintf(b, sizeof(b), "%.9g", v);
  return String(b);
}

bool calcApply(double a, char o, double b, double &res) {
  switch (o) {
    case '+': res = a + b; return true;
    case '-': res = a - b; return true;
    case '*': res = a * b; return true;
    case '/':
      if (b == 0) return false;
      res = a / b;
      return true;
  }
  res = b;
  return true;
}

String calcSym(char o) { return o == '*' ? String("x") : String(o); }

void calcClear() {
  calcCur = "0";
  calcExpr = "";
  calcAcc = 0;
  calcOp = 0;
  calcFresh = true;
  calcErr = false;
}

void calcPress(const String &k) {
  if (calcErr && k != "AC") calcClear();
  char c = k[0];

  if (k.length() == 1 && c >= '0' && c <= '9') {
    if (calcFresh) {
      calcCur = String(c);
      calcFresh = false;
    } else if (calcCur == "0") {
      calcCur = String(c);
    } else if (calcCur == "-0") {
      calcCur = String("-") + c;
    } else {
      int digits = 0;
      for (int i = 0; i < (int)calcCur.length(); i++)
        if (calcCur[i] >= '0' && calcCur[i] <= '9') digits++;
      if (digits < 9) calcCur += c;
    }
    if (calcOp == 0) calcExpr = "";
  } else if (k == ".") {
    if (calcFresh) {
      calcCur = "0.";
      calcFresh = false;
    } else if (calcCur.indexOf('.') < 0) {
      calcCur += ".";
    }
    if (calcOp == 0) calcExpr = "";
  } else if (k == "AC") {
    calcClear();
  } else if (k == "+/-") {
    if (calcCur != "0") {
      if (calcCur.startsWith("-")) calcCur.remove(0, 1);
      else calcCur = "-" + calcCur;
    }
  } else if (k == "%") {
    calcCur = calcFmt(atof(calcCur.c_str()) / 100.0);
    calcErr = (calcCur == "Error");
    calcFresh = false;
  } else if (k == "+" || k == "-" || k == "*" || k == "/") {
    if (calcOp && !calcFresh) {
      double r;
      if (!calcApply(calcAcc, calcOp, atof(calcCur.c_str()), r) || isinf(r)) {
        calcErr = true;
        calcCur = "Error";
        calcExpr = "";
        calcOp = 0;
        calcFresh = true;
        return;
      }
      calcAcc = r;
      calcCur = calcFmt(r);
    } else if (!calcOp) {
      calcAcc = atof(calcCur.c_str());
    }
    calcOp = c;
    calcFresh = true;
    calcExpr = calcFmt(calcAcc) + " " + calcSym(calcOp);
  } else if (k == "=") {
    if (calcOp) {
      double b = atof(calcCur.c_str());
      double r;
      String ex = calcFmt(calcAcc) + " " + calcSym(calcOp) + " " + calcFmt(b) + " =";
      if (!calcApply(calcAcc, calcOp, b, r) || isinf(r)) {
        calcErr = true;
        calcCur = "Error";
        calcExpr = "";
      } else {
        calcCur = calcFmt(r);
        calcExpr = ex;
      }
      calcOp = 0;
      calcFresh = true;
    }
  }
}

void drawCalcKey(int r, int c, bool pressed) {
  if (r == 4 && c == 1) return;  // covered by the wide zero key
  const char* k = CALC_KEYS[r][c];
  bool isOp = (c == 3);
  bool isFn = (r == 0 && c < 3);
  bool wide = (r == 4 && c == 0);
  int x = 12 + c * 76, y = 150 + r * 62, w = wide ? 144 : 68, h = 54;

  uint16_t orange = c565(255, 159, 10), white = c565(255, 255, 255), black = c565(0, 0, 0);
  uint16_t face, txt;
  if (isOp) {
    bool active = (calcOp != 0 && calcFresh && k[0] == calcOp);
    face = pressed ? c565(255, 200, 120) : (active ? white : orange);
    txt = active ? orange : white;
  } else if (isFn) {
    face = pressed ? c565(215, 215, 220) : c565(165, 165, 170);
    txt = black;
  } else {
    face = pressed ? c565(115, 115, 120) : c565(51, 51, 54);
    txt = white;
  }

  String lbl = k;
  if (lbl == "*") lbl = "x";
  gfx->fillRoundRect(x, y, w, h, 27, face);
  gfx->setTextDatum(lgfx::middle_center);
  gfx->setTextColor(txt);
  gfx->drawString(lbl, wide ? x + 34 : x + w / 2, y + h / 2, 4);
}

void drawCalc(int anim) {
  beginFull();
  gfx->fillScreen(c565(0, 0, 0));
  drawBack(c565(255, 159, 10));

  gfx->setTextDatum(lgfx::bottom_right);
  gfx->setTextColor(c565(150, 150, 155));
  gfx->drawString(calcExpr, 308, 92, 2);

  gfx->setTextSize(calcCur.length() <= 9 ? 2 : 1);
  gfx->setTextDatum(lgfx::bottom_right);
  gfx->setTextColor(c565(255, 255, 255));
  gfx->drawString(calcCur, 308, 142, 4);
  gfx->setTextSize(1);

  for (int r = 0; r < 5; r++)
    for (int c = 0; c < 4; c++) drawCalcKey(r, c, false);
  endFull(anim);
}

void handleCalcTouch(int tx, int ty) {
  if (ty < 150 || tx < 12) return;
  int r = (ty - 150) / 62;
  if (r > 4 || (ty - 150) % 62 >= 54) return;
  int c;
  if (r == 4 && tx < 156) {
    c = 0;  // wide zero key
  } else {
    c = (tx - 12) / 76;
    if (c > 3 || (tx - 12) % 76 >= 68) return;
  }
  gfx = &tft;
  drawCalcKey(r, c, true);
  delay(40);
  calcPress(CALC_KEYS[r][c]);
  drawCalc(0);
}

