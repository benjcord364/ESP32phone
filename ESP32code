// SOFTWARE UPDATE (checks a version.json on GitHub, installs firmware over WiFi)
bool updCheck() {
  updState = U_CHECKING;
  updMsg = "";
  updAvail = false;

  if (!wifiConnected) {
    updState = U_ERROR;
    updMsg = "No WiFi connection";
    return false;
  }
  if (String(UPDATE_URL).indexOf("YOUR_") >= 0) {
    updState = U_ERROR;
    updMsg = "Update link not set up yet";
    return false;
  }

  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setTimeout(10000);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.begin(client, String(UPDATE_URL) + "?t=" + String(millis()));   // ?t= skips GitHub's cache
  int code = http.GET();

  bool ok = false;
  if (code == 200) {
    String payload = http.getString();
    DynamicJsonDocument doc(2048);
    DeserializationError err = deserializeJson(doc, payload);
    if (!err) {
      updNewBuild = doc["build"] | 0;
      updNewVer = String((const char*)(doc["version"] | "?"));
      updNotes = String((const char*)(doc["notes"] | ""));
      updUrl = String((const char*)(doc["url"] | ""));
      // Only download from GitHub's raw file host
      if (!updUrl.startsWith("https://raw.githubusercontent.com/")) {
        updState = U_ERROR;
        updMsg = "Blocked: untrusted download link";
      } else if (updNewBuild > FW_BUILD) {
        updState = U_AVAIL;
        updAvail = true;
        ok = true;
      } else {
        updState = U_UPTODATE;
        ok = true;
      }
    } else {
      updState = U_ERROR;
      updMsg = "Couldn't read version info";
    }
  } else if (code > 0) {
    updState = U_ERROR;
    updMsg = "HTTP " + String(code);
  } else {
    updState = U_ERROR;
    updMsg = http.errorToString(code);
  }
  http.end();
  return ok;
}

void updProgress(int cur, int total) {
  int pct = total > 0 ? (int)((int64_t)cur * 100 / total) : 0;
  if (pct == updLastPct) return;
  updLastPct = pct;
  lgfx::LGFXBase* save = gfx;
  gfx = &tft;
  tft.fillRoundRect(30, 300, 260, 14, 7, sepColor);
  int w = 260 * pct / 100;
  if (w > 0) tft.fillRoundRect(30, 300, w < 14 ? 14 : w, 14, 7, accentColor);
  tft.fillRect(0, 322, 320, 30, bgColor);
  tft.setTextDatum(lgfx::middle_center);
  tft.setTextColor(textColor);
  tft.drawString(String(pct) + "%", 160, 336, 4);
  gfx = save;
}

void updInstall() {
  updState = U_INSTALL;
  updLastPct = -1;
  drawUpdate(0);

  WiFiClientSecure client;
  client.setInsecure();
  httpUpdate.rebootOnUpdate(false);
  httpUpdate.setFollowRedirects(HTTPC_FORCE_FOLLOW_REDIRECTS);
  httpUpdate.onProgress(updProgress);
  t_httpUpdate_return r = httpUpdate.update(client, updUrl);

  if (r == HTTP_UPDATE_OK) {
    gfx = &tft;
    tft.fillRect(0, 230, 320, 140, bgColor);
    tft.setTextDatum(lgfx::middle_center);
    tft.setTextColor(greenColor);
    tft.drawString("Installed!", 160, 280, 4);
    tft.setTextColor(subColor);
    tft.drawString("Restarting...", 160, 320, 2);
    delay(1500);
    ESP.restart();
  } else {
    updState = U_ERROR;
    updMsg = (r == HTTP_UPDATE_NO_UPDATES) ? String("No update found") : httpUpdate.getLastErrorString();
    drawUpdate(0);
  }
}

void openUpdate() {
  currentScreen = UPDATE;
  updState = U_CHECKING;
  drawUpdate(1);
  updCheck();
  drawUpdate(0);
}

void drawUpdate(int anim) {
  beginFull();
  uint16_t white = c565(255, 255, 255);
  gfx->fillScreen(bgColor);
  drawHeader("Update");

  // big icon
  gfx->fillCircle(160, 112, 42, accentColor);
  gfx->fillRect(155, 90, 11, 24, white);
  gfx->fillTriangle(138, 112, 182, 112, 160, 136, white);

  gfx->setTextDatum(lgfx::middle_center);
  gfx->setTextColor(textColor);
  gfx->drawString("Version " + String(FW_VERSION) + "  (build " + String(FW_BUILD) + ")", 160, 180, 2);

  const char* btn = nullptr;
  uint16_t btnCol = accentColor;

  if (updState == U_CHECKING) {
    gfx->setTextColor(subColor);
    gfx->drawString("Checking for updates...", 160, 225, 4);
    btn = "Checking...";
    btnCol = sepColor;
  } else if (updState == U_UPTODATE) {
    gfx->setTextColor(greenColor);
    gfx->drawString("You're up to date", 160, 225, 4);
    btn = "Check again";
  } else if (updState == U_AVAIL) {
    gfx->setTextColor(textColor);
    gfx->drawString("Update available", 160, 215, 4);
    gfx->setTextColor(accentColor);
    gfx->drawString("Version " + updNewVer + "  (build " + String(updNewBuild) + ")", 160, 245, 2);
    if (updNotes.length()) {
      std::vector<String> lines;
      wrapText(updNotes, 38, lines);
      gfx->setTextColor(subColor);
      for (int i = 0; i < (int)lines.size() && i < 5; i++)
        gfx->drawString(lines[i], 160, 275 + i * 18, 2);
    }
    btn = "Install update";
    btnCol = greenColor;
  } else if (updState == U_ERROR) {
    gfx->setTextColor(redColor);
    gfx->drawString("Couldn't update", 160, 220, 4);
    std::vector<String> lines;
    wrapText(updMsg, 36, lines);
    gfx->setTextColor(subColor);
    for (int i = 0; i < (int)lines.size() && i < 4; i++)
      gfx->drawString(lines[i], 160, 252 + i * 18, 2);
    btn = "Try again";
  } else if (updState == U_INSTALL) {
    gfx->setTextColor(textColor);
    gfx->drawString("Installing...", 160, 225, 4);
    gfx->setTextColor(subColor);
    gfx->drawString("Keep the phone powered on", 160, 258, 2);
    gfx->fillRoundRect(30, 300, 260, 14, 7, sepColor);
  } else {
    gfx->setTextColor(subColor);
    gfx->drawString("Tap below to check", 160, 225, 4);
    btn = "Check for updates";
  }

  if (btn) {
    gfx->fillRoundRect(40, 380, 240, 50, 25, btnCol);
    gfx->setTextDatum(lgfx::middle_center);
    gfx->setTextColor(white);
    gfx->drawString(btn, 160, 405, 2);
  }
  endFull(anim);
}

void handleUpdateTouch(int tx, int ty) {
  if (ty >= 380 && ty < 430 && tx >= 40 && tx < 280) {
    if (updState == U_AVAIL) {
      updInstall();
    } else if (updState != U_CHECKING && updState != U_INSTALL) {
      updState = U_CHECKING;
      drawUpdate(0);
      updCheck();
      drawUpdate(0);
    }
  }
}

