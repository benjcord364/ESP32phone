// TIME HELPERS
void syncTime() { configTzTime(TIME_ZONE, "pool.ntp.org", "time.nist.gov"); }

String fmtTime12(const struct tm &ti, String &ap) {
  int h = ti.tm_hour % 12;
  if (h == 0) h = 12;
  ap = (ti.tm_hour >= 12) ? "PM" : "AM";
  char b[10];
  snprintf(b, sizeof(b), "%d:%02d", h, ti.tm_min);
  return String(b);
}

void drawBigClock(int ty) {
  const char* dayNames[] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
  const char* monNames[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
  uint16_t white = c565(255, 255, 255);
  gfx->setTextDatum(lgfx::middle_center);
  struct tm ti;
  if (getLocalTime(&ti, 0)) {
    String ap;
    String t = fmtTime12(ti, ap);
    shadowText(t, 125, ty, 7, white);
    shadowText(ap, 272, ty + 12, 4, white);
    shadowText(String(dayNames[ti.tm_wday]) + ", " + monNames[ti.tm_mon] + " " + String(ti.tm_mday), 160, ty + 48, 4, white);
  } else {
    shadowText("--:--", 160, ty, 7, white);
    shadowText(wifiConnected ? "Setting time..." : "Connect WiFi to set time", 160, ty + 48, 2, white);
  }
}

// =====================================================
void setup() {
  Serial.begin(115200);
  tft.init();
  tft.setRotation(0);
  tft.fillScreen(0);
  tft.setBrightness(0);
  ft6336u.begin();

  preferences.begin("settings", false);
  loadSettings();
  applyTheme();

  // API key: a real key in the code gets saved on the phone; otherwise use the saved one
  if (!openRouterKey.startsWith("PASTE") && openRouterKey.length() > 10) {
    if (preferences.getString("orkey", "") != openRouterKey) preferences.putString("orkey", openRouterKey);
  } else {
    openRouterKey = preferences.getString("orkey", "");
  }

  if (psramFound()) {
    spr.setColorDepth(16);
    spr.setPsram(true);
    haveSpr = (spr.createSprite(320, 480) != nullptr);
  }
  Serial.println(haveSpr ? "Smooth mode: ON" : "Smooth mode: OFF (enable PSRAM in the Tools menu)");

  // Splash + fade in
  beginFull();
  drawWallpaper(wallIdx, 0, 0, 320, 480);
  gfx->setTextDatum(lgfx::middle_center);
  shadowText("ESP32 Phone", 160, 225, 4, c565(255, 255, 255));
  shadowText("Starting...", 160, 258, 2, c565(255, 255, 255));
  endFull(0);
  for (int b = 0; b <= brightness; b += 12) {
    tft.setBrightness(b);
    delay(14);
  }
  setBrightness(brightness);

  tryAutoConnect();
  syncTime();
  if (wifiConnected) {
    wxDownload();
    updCheck();          // quiet check: Settings shows "Available" if there is an update
    updState = U_IDLE;
  }

  if (lockPin.length() > 0) {
    currentScreen = LOCK;
    drawLockScreen(3);
  } else {
    currentScreen = HOME;
    drawHomeScreen(3);
  }
}

