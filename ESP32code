// conversation memory sent to the AI with every request
void convAdd(bool user, const String &t) {
  if (convCount >= CONV_MAX) {
    for (int i = 1; i < CONV_MAX; i++) {
      convText[i - 1] = convText[i];
      convUser[i - 1] = convUser[i];
    }
    convCount = CONV_MAX - 1;
  }
