void drawGradientV(int x, int y, int w, int h, const Col &top, const Col &bot) {
  for (int j = 0; j < h; j += 2) {
    int hh = (h - j >= 2) ? 2 : (h - j);
    gfx->fillRect(x, y + j, w, hh, c565v(lerpCol(top, bot, h > 1 ? (float)j / (h - 1) : 0.0f)));
  }
}

void shadowText(const String &s, int x, int y, int font, uint16_t col) {
  gfx->setTextColor(c565(10, 10, 30));
  gfx->drawString(s, x + 1, y + 1, font);
  gfx->setTextColor(col);
  gfx->drawString(s, x, y, font);
}

Col wallColorAt(int idx, float t) {
  const Wall &W = WALLS[idx];
  return t < 0.5f ? lerpCol(W.top, W.mid, t * 2) : lerpCol(W.mid, W.bot, (t - 0.5f) * 2);
}

uint16_t glassAt(int y, float a) {
  Col c = wallColorAt(wallIdx, y / 480.0f);
  return c565v(lerpCol(c, Col{255, 255, 255}, a));
}

void drawStars(int x, int y, int w, int h, int n, uint32_t seed, float maxFy) {
  for (int i = 0; i < n; i++) {
    seed = seed * 1664525u + 1013904223u;
    int px = x + (int)((seed >> 8) % (uint32_t)w);
    seed = seed * 1664525u + 1013904223u;
    int py = y + (int)(((seed >> 8) % 1000) / 1000.0f * maxFy * h);
    seed = seed * 1664525u + 1013904223u;
    int br = 150 + (int)((seed >> 8) % 105);
    uint16_t c = c565(br, br, br);
    if (w > 200 && i % 7 == 0) gfx->fillCircle(px, py, 1, c);
    else gfx->drawPixel(px, py, c);
  }
}

void drawHill(int x, int y, int w, int h, float baseF, float ampF, float freq, float phase, uint16_t col) {
  int step = (w > 200) ? 2 : 1;
  for (int cx = 0; cx < w; cx += step) {
    float yy = h * baseF + h * ampF * sinf(freq * 6.2832f * cx / w + phase);
    int yi = (int)yy;
    if (yi < 0) yi = 0;
    if (yi >= h) continue;
    gfx->fillRect(x + cx, y + yi, step, h - yi, col);
  }
}

void drawWallpaper(int idx, int x, int y, int w, int h) {
  gfx->setClipRect(x, y, w, h);
  for (int j = 0; j < h; j += 2) {
    int hh = (h - j >= 2) ? 2 : (h - j);
    gfx->fillRect(x, y + j, w, hh, c565v(wallColorAt(idx, h > 1 ? (float)j / (h - 1) : 0.0f)));
  }
  float s = w / 320.0f;
  auto PX = [&](float f) -> int { return x + (int)(f * w); };
  auto PY = [&](float f) -> int { return y + (int)(f * h); };

  switch (idx) {
    case 0: {  // Sunset
      int cx = PX(0.5f), cy = PY(0.60f);
      for (int k = 3; k >= 0; k--) {
        Col c = lerpCol(wallColorAt(0, 0.6f), Col{255, 226, 140}, k == 0 ? 1.0f : 0.18f * (4 - k));
        gfx->fillCircle(cx, cy, (int)((46 + k * 16) * s), c565v(c));
      }
      drawHill(x, y, w, h, 0.72f, 0.030f, 1.2f, 0.0f, c565(60, 24, 80));
      drawHill(x, y, w, h, 0.80f, 0.035f, 0.8f, 1.5f, c565(36, 14, 56));
      drawHill(x, y, w, h, 0.90f, 0.030f, 1.5f, 3.0f, c565(20, 8, 34));
      break;
    }
    case 1: {  // Ocean
      gfx->fillCircle(PX(0.76f), PY(0.17f), (int)(20 * s), c565(240, 240, 225));
      drawHill(x, y, w, h, 0.60f, 0.015f, 3.0f, 0.0f, c565(26, 120, 160));
      drawHill(x, y, w, h, 0.70f, 0.018f, 2.5f, 1.0f, c565(18, 96, 138));
      drawHill(x, y, w, h, 0.81f, 0.020f, 2.0f, 2.0f, c565(12, 72, 112));
      drawHill(x, y, w, h, 0.92f, 0.020f, 1.5f, 3.0f, c565(8, 48, 86));
      break;
    }
    case 2: {  // Aurora
      drawStars(x, y, w, h, 60, 7, 0.6f);
      int step = (w > 200) ? 3 : 1;
      int seg = (int)(5 * s);
      if (seg < 2) seg = 2;
      for (int b = 0; b < 2; b++) {
        Col ac = (b == 0) ? Col{60, 255, 160} : Col{150, 90, 255};
        float baseF = 0.30f + b * 0.14f;
        Col bg = wallColorAt(2, baseF);
        uint16_t cc[15];
        for (int m = -7; m <= 7; m++) {
          float a = (1.0f - fabsf((float)m) / 8.0f) * 0.6f;
          cc[m + 7] = c565v(lerpCol(bg, ac, a));
        }
        for (int cx = 0; cx < w; cx += step) {
          int yy = (int)(h * (baseF + 0.05f * sinf(6.2832f * 1.3f * cx / w + b * 2.0f)));
          for (int m = -7; m <= 7; m++) {
            gfx->fillRect(x + cx, y + yy + m * seg, step, seg + 1, cc[m + 7]);
          }
        }
      }
      drawHill(x, y, w, h, 0.86f, 0.030f, 1.5f, 0.0f, c565(4, 20, 22));
      drawHill(x, y, w, h, 0.93f, 0.030f, 2.0f, 1.0f, c565(2, 12, 14));
      break;
    }
    case 3: {  // Forest
      int cx = PX(0.78f), cy = PY(0.18f);
      for (int k = 2; k >= 0; k--) {
        Col c = lerpCol(wallColorAt(3, 0.18f), Col{255, 250, 210}, k == 0 ? 1.0f : 0.25f * (3 - k));
        gfx->fillCircle(cx, cy, (int)((24 + k * 12) * s), c565v(c));
      }
      gfx->fillTriangle(PX(0.0f), PY(0.78f), PX(0.28f), PY(0.40f), PX(0.58f), PY(0.78f), c565(96, 150, 140));
      gfx->fillTriangle(PX(0.35f), PY(0.80f), PX(0.65f), PY(0.34f), PX(1.0f), PY(0.80f), c565(70, 124, 112));
      gfx->fillTriangle(PX(-0.1f), PY(0.85f), PX(0.2f), PY(0.55f), PX(0.5f), PY(0.85f), c565(46, 100, 84));
      drawHill(x, y, w, h, 0.80f, 0.030f, 1.0f, 0.5f, c565(30, 84, 56));
      drawHill(x, y, w, h, 0.90f, 0.030f, 1.3f, 2.0f, c565(18, 60, 40));
      break;
    }
    case 4: {  // Midnight
      drawStars(x, y, w, h, 140, 3, 0.85f);
      int cx = PX(0.74f), cy = PY(0.18f);
      gfx->fillCircle(cx, cy, (int)(26 * s), c565(245, 240, 210));
      gfx->fillCircle(cx + (int)(10 * s), cy - (int)(5 * s), (int)(22 * s), c565v(wallColorAt(4, 0.18f)));
      break;
    }
    case 5: {  // Candy
      Col wh = {255, 255, 255};
      gfx->fillCircle(PX(0.15f), PY(0.22f), (int)(95 * s), c565v(lerpCol(wallColorAt(5, 0.22f), wh, 0.22f)));
      gfx->fillCircle(PX(0.95f), PY(0.55f), (int)(115 * s), c565v(lerpCol(wallColorAt(5, 0.55f), wh, 0.18f)));
      gfx->fillCircle(PX(0.30f), PY(0.90f), (int)(85 * s), c565v(lerpCol(wallColorAt(5, 0.90f), Col{255, 210, 230}, 0.35f)));
      gfx->fillCircle(PX(0.75f), PY(0.15f), (int)(30 * s), c565v(lerpCol(wallColorAt(5, 0.15f), wh, 0.40f)));
      break;
    }
  }
  gfx->clearClipRect();
}

