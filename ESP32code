bool handleKeyboardKey(int tx, int ty, String &buf, bool &shift) {
  const char* rows[3] = {"1234567890", "qwertyuiop", "asdfghjkl"};
  int idx = (tx - 5) / 32;
  if (idx < 0) idx = 0;
  if (ty >= 230 && ty < 350) {
    int r = (ty - 230) / 40;
    int y = 230 + r * 40;
    if (r == 2 && tx >= 293) {
      flashKey(293, y, 24, 36, "<-", keySpecialColor, textColor, 1);
      if (buf.length() > 0) buf.remove(buf.length() - 1);
      return true;
    }
    int maxIdx = (r == 2) ? 9 : 10;
    if (idx >= maxIdx) return false;
    char k = rows[r][idx];
    if (r > 0 && shift) k = toupper(k);
    char b[2] = {k, 0};
    flashKey(5 + idx * 32, y, 29, 36, b, keyFaceColor, textColor, 2);
    buf += k;
    return true;
  } else if (ty >= 350 && ty < 390) {
    if (tx >= 229) {
      flashKey(229, 350, 86, 36, "Space", keyFaceColor, textColor, 2);
      buf += " ";
      return true;
    }
    if (idx >= 7) return false;
    char k = "zxcvbnm"[idx];
    if (shift) k = toupper(k);
    char b[2] = {k, 0};
    flashKey(5 + idx * 32, 350, 29, 36, b, keyFaceColor, textColor, 2);
    buf += k;
    return true;
  } else if (ty >= 390 && ty < 428 && tx >= 5 && tx <= 95) {
    shift = !shift;
    drawGoodKeyboard(shift);
    return false;
  }
  return false;
}

