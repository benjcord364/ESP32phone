uint16_t snBg(int cx, int cy) {
  return ((cx + cy) & 1) ? c565(162, 209, 73) : c565(170, 215, 81);
}

void snCell(int cx, int cy, uint16_t col) {
  tft.fillRect(SN_X0 + cx * SN_CELL, SN_Y0 + cy * SN_CELL, SN_CELL, SN_CELL, col);
}

void snDrawBody(int cx, int cy) {
  snCell(cx, cy, snBg(cx, cy));
  tft.fillRoundRect(SN_X0 + cx * SN_CELL + 1, SN_Y0 + cy * SN_CELL + 1, SN_CELL - 2, SN_CELL - 2, 6, c565(66, 115, 245));
}

void snDrawHead(int cx, int cy) {
  snCell(cx, cy, snBg(cx, cy));
  int px = SN_X0 + cx * SN_CELL, py = SN_Y0 + cy * SN_CELL;
  tft.fillRoundRect(px, py, SN_CELL, SN_CELL, 8, c565(40, 85, 220));
  int ex1, ey1, ex2, ey2;
  if (snDx != 0) {
    ex1 = ex2 = px + (snDx > 0 ? 13 : 7);
    ey1 = py + 6;
    ey2 = py + 14;
  } else {
    ey1 = ey2 = py + (snDy > 0 ? 13 : 7);
    ex1 = px + 6;
    ex2 = px + 14;
  }
  tft.fillCircle(ex1, ey1, 3, c565(255, 255, 255));
  tft.fillCircle(ex2, ey2, 3, c565(255, 255, 255));
  tft.fillCircle(ex1 + snDx, ey1 + snDy, 1, c565(0, 0, 0));
  tft.fillCircle(ex2 + snDx, ey2 + snDy, 1, c565(0, 0, 0));
}

void snDrawFood() {
  if (snFoodX < 0) return;
  snCell(snFoodX, snFoodY, snBg(snFoodX, snFoodY));
  int px = SN_X0 + snFoodX * SN_CELL, py = SN_Y0 + snFoodY * SN_CELL;
  tft.fillCircle(px + 10, py + 11, 7, c565(230, 50, 50));
  tft.fillCircle(px + 8, py + 9, 2, c565(255, 160, 160));
  tft.fillRect(px + 10, py + 1, 2, 4, c565(90, 60, 30));
  tft.fillTriangle(px + 12, py + 3, px + 17, py + 1, px + 13, py + 6, c565(60, 160, 60));
}

void snDrawHeader() {
  gfx = &tft;
