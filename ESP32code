               "&temperature_unit=" + String(useMetric ? "celsius" : "fahrenheit") +
               "&wind_speed_unit=" + String(useMetric ? "kmh" : "mph") +
               "&timezone=auto&forecast_days=5";
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setTimeout(15000);
  http.begin(client, url);
  int code = http.GET();
  wxValid = false;
  if (code == 200) {
    String payload = http.getString();
    DynamicJsonDocument doc(6144);
