// ---------------- Color helpers ----------------
struct Col { uint8_t r, g, b; };
static inline uint16_t c565(int r, int gr, int b) {
  return (uint16_t)(((r & 0xF8) << 8) | ((gr & 0xFC) << 3) | ((b & 0xFF) >> 3));
}
static inline uint16_t c565v(const Col &c) { return c565(c.r, c.g, c.b); }
static Col lerpCol(const Col &a, const Col &b, float t) {
  if (t < 0) t = 0;
  if (t > 1) t = 1;
  Col o;
  o.r = (uint8_t)(a.r + (b.r - a.r) * t);
  o.g = (uint8_t)(a.g + (b.g - a.g) * t);
  o.b = (uint8_t)(a.b + (b.b - a.b) * t);
  return o;
}

