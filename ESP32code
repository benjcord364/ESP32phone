}

void snDrawBoard() {
  gfx = &tft;
  for (int cy = 0; cy < SN_ROWS; cy++)
    for (int cx = 0; cx < SN_COLS; cx++) snCell(cx, cy, snBg(cx, cy));
  snDrawFood();
  for (int i = snLen - 1; i >= 1; i--) snDrawBody(snX[i], snY[i]);
  snDrawHead(snX[0], snY[0]);
  tft.fillRect(0, SN_Y0 + SN_ROWS * SN_CELL, 320, 480 - (SN_Y0 + SN_ROWS * SN_CELL), statusBarColor);
  tft.setTextDatum(lgfx::middle_center);
