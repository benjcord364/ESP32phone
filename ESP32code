void handleNotesListTouch(int tx, int ty) {
  if (ty < 50 && tx > 250) {
    if (noteCount < MAX_NOTES) {
      notes[noteCount] = "";
      curNote = noteCount;
      noteCount++;
      noteShift = false;
      currentScreen = NOTE_EDIT;
      drawNoteEdit(1);
    }
    return;
  }
  if (ty >= 62) {
    int i = (ty - 62) / 50;
    if (i < noteCount && (ty - 62) % 50 < 44) {
      curNote = i;
      noteShift = false;
      currentScreen = NOTE_EDIT;
      drawNoteEdit(1);
    }
  }
