// DRAW TARGET + TRANSITIONS
void beginFull() {
  gfx = haveSpr ? (lgfx::LGFXBase*)&spr : (lgfx::LGFXBase*)&tft;
}

// anim: 0 none, 1 slide from right, 2 from left, 3 from bottom, 4 from top
void endFull(int anim) {
  gfx = &tft;
  if (!haveSpr) return;
  if (anim == 0) {
    spr.pushSprite(0, 0);
    return;
  }
  const float fr[6] = {0.35f, 0.62f, 0.80f, 0.92f, 0.98f, 1.0f};
  for (int i = 0; i < 6; i++) {
    if (anim == 1) spr.pushSprite(320 - (int)(320 * fr[i]), 0);
    else if (anim == 2) spr.pushSprite(-320 + (int)(320 * fr[i]), 0);
    else if (anim == 3) spr.pushSprite(0, 480 - (int)(480 * fr[i]));
    else spr.pushSprite(0, -480 + (int)(480 * fr[i]));
  }
}

