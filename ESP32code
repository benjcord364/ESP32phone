    wrapText(notes[curNote] + "|", 32, lines);
    int maxL = 7;
    int start = (int)lines.size() > maxL ? (int)lines.size() - maxL : 0;
    gfx->setTextColor(textColor);
    for (int k = start; k < (int)lines.size(); k++)
