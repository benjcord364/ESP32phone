void handleNoteEditTouch(int tx, int ty) {
  if (curNote < 0 || curNote >= noteCount) return;
  if (ty < 50 && tx > 230) {             // Delete
    removeNote(curNote);
    curNote = -1;
    saveNotes();
    currentScreen = NOTES_LIST;
    drawNotesList(2);
    return;
  }
  if (ty >= 430 && ty < 475) {           // Done
    finishNote();
    currentScreen = NOTES_LIST;
    drawNotesList(2);
    return;
  }
  if (handleKeyboardKey(tx, ty, notes[curNote], noteShift)) {
    if ((int)notes[curNote].length() > NOTE_LEN) notes[curNote].remove(NOTE_LEN);
    drawNoteTextArea();
  }
  delay(40);
}

