void wrapText(const String &s, int maxChars, std::vector<String> &out) {
  out.clear();
  String line = "";
  int i = 0, n = s.length();
  while (i < n) {
    int j = i;
    while (j < n && s[j] != ' ') j++;
    String word = s.substring(i, j);
    while ((int)word.length() > maxChars) {
      if (line.length()) { out.push_back(line); line = ""; }
      out.push_back(word.substring(0, maxChars));
      word = word.substring(maxChars);
    }
    if ((int)(line.length() + (line.length() ? 1 : 0) + word.length()) > maxChars) {
      if (line.length()) out.push_back(line);
      line = word;
    } else {
      if (line.length()) line += " ";
      line += word;
    }
    i = j + 1;
  }
  if (line.length() || out.empty()) out.push_back(line);
}

void drawChatBubbles(int top, int bottom) {
  uint16_t white = c565(255, 255, 255);
  int areaH = bottom - top;
  if (aiThinking) areaH -= 34;

  if (chatCount == 0) {
    drawAppIcon(1, 128, top + 40, 64);
    gfx->setTextDatum(lgfx::middle_center);
    gfx->setTextColor(subColor);
    gfx->drawString("Ask me anything", 160, top + 130, 2);
  }

  std::vector<std::vector<String>> shown;  // newest first
  std::vector<int> idxs;
  int used = 0;
  for (int i = chatCount - 1; i >= 0; i--) {
    String m = chatHistory[i];
    bool user = m.startsWith("You: ");
    m = m.substring(user ? 5 : 4);
    std::vector<String> lines;
    wrapText(m, 38, lines);
    int h = (int)lines.size() * 12 + 12 + 6;
    if (used + h > areaH) {
      if (shown.empty()) {
        int maxL = (areaH - 18) / 12;
        if (maxL < 1) maxL = 1;
        if ((int)lines.size() > maxL) lines.resize(maxL);
        shown.push_back(lines);
        idxs.push_back(i);
        used = areaH;
      }
      break;
    }
    shown.push_back(lines);
    idxs.push_back(i);
    used += h;
  }

  int y = top;
  for (int k = (int)shown.size() - 1; k >= 0; k--) {
    bool user = chatHistory[idxs[k]].startsWith("You: ");
    std::vector<String> &lines = shown[k];
    int maxLen = 0;
    for (size_t j = 0; j < lines.size(); j++)
      if ((int)lines[j].length() > maxLen) maxLen = lines[j].length();
    int w = maxLen * 6 + 20;
    if (w < 44) w = 44;
    int h = (int)lines.size() * 12 + 12;
    int x = user ? 312 - w : 8;
    gfx->fillRoundRect(x, y, w, h, 12, user ? accentColor : bubbleAiColor);
