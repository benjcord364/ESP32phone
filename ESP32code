long timerRemainingMs() {
  if (timerRunning) {
    long r = (long)(timerEndMs - millis());
    return r > 0 ? r : 0;
  }
  return timerRemainMs;
}

unsigned long swElapsed() {
  return swRunning ? swAccum + (millis() - swStartMs) : swAccum;
}

String timerText(long ms) {
  long s = (ms + 999) / 1000;
  char b[12];
  snprintf(b, sizeof(b), "%02ld:%02ld", s / 60, s % 60);
  return String(b);
}

String swText(unsigned long ms) {
  unsigned long t = ms / 100;
  char b[16];
  snprintf(b, sizeof(b), "%02lu:%02lu.%lu", (t / 600) % 100, (t / 10) % 60, t % 10);
  return String(b);
}

void handLine(float angDeg, float len, int th, uint16_t col) {
  float a = angDeg * 0.0174533f;
  int x1 = CLK_CX + (int)(cosf(a) * len);
  int y1 = CLK_CY + (int)(sinf(a) * len);
  thickLine(CLK_CX, CLK_CY, x1, y1, th, col);
}

void drawHandsAt(int h, int m, int s, uint16_t cH, uint16_t cM, uint16_t cS) {
  float ha = ((h % 12) + m / 60.0f) * 30.0f - 90.0f;
  float ma = (m + s / 60.0f) * 6.0f - 90.0f;
  float sa = s * 6.0f - 90.0f;
  handLine(ha, 50, 5, cH);
  handLine(ma, 74, 3, cM);
  float a = sa * 0.0174533f;
  int x1 = CLK_CX + (int)(cosf(a) * 84), y1 = CLK_CY + (int)(sinf(a) * 84);
  int x0 = CLK_CX - (int)(cosf(a) * 16), y0 = CLK_CY - (int)(sinf(a) * 16);
  gfx->drawLine(x0, y0, x1, y1, cS);
  gfx->drawLine(x0 + 1, y0, x1 + 1, y1, cS);
}

void drawAnalogDecor() {
  for (int i = 0; i < 60; i++) {
    float a = (i * 6 - 90) * 0.0174533f;
    if (i % 5 == 0) {
      int x0 = CLK_CX + (int)(cosf(a) * (CLK_R - 16)), y0 = CLK_CY + (int)(sinf(a) * (CLK_R - 16));
      int x1 = CLK_CX + (int)(cosf(a) * (CLK_R - 6)), y1 = CLK_CY + (int)(sinf(a) * (CLK_R - 6));
      thickLine(x0, y0, x1, y1, 2, textColor);
    } else {
      gfx->fillCircle(CLK_CX + (int)(cosf(a) * (CLK_R - 6)), CLK_CY + (int)(sinf(a) * (CLK_R - 6)), 1, subColor);
    }
  }
  gfx->setTextDatum(lgfx::middle_center);
  gfx->setTextColor(textColor);
  gfx->drawString("12", CLK_CX, CLK_CY - CLK_R + 32, 2);
  gfx->drawString("3", CLK_CX + CLK_R - 32, CLK_CY, 2);
  gfx->drawString("6", CLK_CX, CLK_CY + CLK_R - 32, 2);
  gfx->drawString("9", CLK_CX - CLK_R + 32, CLK_CY, 2);
}

void drawHub() {
  gfx->fillCircle(CLK_CX, CLK_CY, 5, textColor);
  gfx->fillCircle(CLK_CX, CLK_CY, 2, redColor);
}

void updateAnalog() {
  struct tm ti;
  if (!getLocalTime(&ti, 0)) return;
  if (prevS >= 0) drawHandsAt(prevH, prevM, prevS, cardColor, cardColor, cardColor);
  drawAnalogDecor();
  drawHandsAt(ti.tm_hour, ti.tm_min, ti.tm_sec, textColor, textColor, redColor);
  drawHub();
  prevH = ti.tm_hour;
  prevM = ti.tm_min;
  prevS = ti.tm_sec;
}

