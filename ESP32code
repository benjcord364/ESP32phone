void handleAITouch(int tx, int ty) {
  // "New" chat: clears the screen AND the AI's memory
  if (tx > 240 && ty < 50) {
    chatCount = 0;
    convCount = 0;
    aiInput = "";
    drawAIChat(0);
    return;
  }
  if (showAIKeyboard) {
    if (ty >= 430 && ty < 475) {
      if (aiInput.length() > 0) {
        String msg = aiInput;
        addChat("You: " + msg);
        aiInput = "";
        showAIKeyboard = false;
        drawAIChat(0);
        sendToAI(msg);
      }
    } else if (handleKeyboardKey(tx, ty, aiInput, aiKeyboardShift)) {
      updateAIInputField();
    }
    delay(40);
    return;
  }
  if (ty > 400 && ty < 470 && tx < 200) {
    showAIKeyboard = true;
    drawAIChat(0);
  } else if (tx > 200 && tx <= 250 && ty > 400 && ty < 470) {
    if (aiInput.length() > 0) {
      String msg = aiInput;
      addChat("You: " + msg);
      aiInput = "";
      drawAIChat(0);
      sendToAI(msg);
    }
  } else if (tx > 260 && ty > 400 && ty < 470) {
    addChat("You: [Mic - coming soon]");
    drawAIChat(0);
  }
}

void sendToAI(String message) {
  if (!wifiConnected) { addChat("AI: No WiFi connection"); drawAIChat(0); return; }
  if (openRouterKey.length() < 10 || openRouterKey.startsWith("PASTE")) { addChat("AI: No API key set"); drawAIChat(0); return; }

  convAdd(true, message);   // remember what you said
  aiThinking = true;
  drawAIChat(0);

  String body;
  {
    DynamicJsonDocument req(8192);
    req["model"] = "openrouter/free";
    req["max_tokens"] = 400;
    JsonArray msgs = req.createNestedArray("messages");
    JsonObject sys = msgs.createNestedObject();
    sys["role"] = "system";
    sys["content"] = "You are a helpful assistant on a small phone screen. Keep answers short and in plain text, no markdown.";
    bool started = false;
    for (int i = 0; i < convCount; i++) {
      if (!started && !convUser[i]) continue;   // history must start with a user message
      started = true;
      JsonObject m = msgs.createNestedObject();
      m["role"] = convUser[i] ? "user" : "assistant";
      m["content"] = convText[i];
    }
    serializeJson(req, body);
  }

  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setTimeout(30000);
  http.begin(client, "https://openrouter.ai/api/v1/chat/completions");
  http.addHeader("Authorization", "Bearer " + openRouterKey);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("HTTP-Referer", "https://esp32-phone.local");
  http.addHeader("X-Title", "ESP32 AI");
  int httpCode = http.POST(body);

  String reply;
  bool ok = false;
  if (httpCode == 200) {
    String response = http.getString();
    StaticJsonDocument<128> filter;
    filter["choices"][0]["message"]["content"] = true;
    DynamicJsonDocument doc(6144);
    DeserializationError err = deserializeJson(doc, response, DeserializationOption::Filter(filter));
    if (!err) {
      const char *content = doc["choices"][0]["message"]["content"];
      if (content && strlen(content) > 0) {
        reply = "AI: " + String(content);
        ok = true;
      } else reply = "AI: Empty response";
    } else reply = "AI: JSON error";
  } else if (httpCode > 0) reply = "AI: HTTP " + String(httpCode);
  else reply = "AI: " + http.errorToString(httpCode);
  http.end();

  for (int i = 0; i < (int)reply.length(); i++) {
    unsigned char ch = reply[i];
    if (ch == '\n' || ch == '\r' || ch == '\t') reply.setCharAt(i, ' ');
    else if (ch < 32 || ch > 126) reply.setCharAt(i, '?');
  }
  if (reply.length() > 400) reply = reply.substring(0, 400) + "...";

  if (ok) convAdd(false, reply.substring(4));   // remember the AI's answer
  else if (convCount > 0) convCount--;          // failed: forget the unanswered question

  addChat(reply);
  aiThinking = false;
  drawAIChat(0);
}

