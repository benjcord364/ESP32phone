void applySliderTouch(int tx) {
  brightness = constrain(map(tx, 40, 280, 30, 255), 30, 255);
  setBrightness(brightness);
  drawBrightnessSlider();
}

void goBack() {
  switch (currentScreen) {
    case WIFI_LIST:
    case WALL_PICK:
      if (fromHome) {
        fromHome = false;
        currentScreen = HOME;
        drawHomeScreen(2);
      } else {
        currentScreen = SETTINGS;
        drawSettingsScreen(2);
      }
      break;
    case PIN_SET:
    case LOC_SEARCH:
    case UPDATE:
      currentScreen = SETTINGS;
      drawSettingsScreen(2);
      break;
    case WIFI_PASSWORD:
      currentScreen = WIFI_LIST;
      drawWifiList(2);
      break;
    case LOC_LIST:
      currentScreen = LOC_SEARCH;
      drawLocSearch(2);
      break;
    case NOTE_EDIT:
      finishNote();
      currentScreen = NOTES_LIST;
      drawNotesList(2);
      break;
    default:
      currentScreen = HOME;
      showAIKeyboard = false;
      drawHomeScreen(2);
      break;
  }
}

// app ids: 0 weather, 1 AI, 2 snake, 3 settings, 4 calculator, 5 wifi, 6 wallpaper, 8 notes, 9 clock
void openApp(int i) {
  if (i == 0) {
    currentScreen = WEATHER;
    fetchWeather(3);
  } else if (i == 1) {
    currentScreen = AI_CHAT;
    showAIKeyboard = false;
    drawAIChat(3);
  } else if (i == 2) {
    currentScreen = GAME;
    snakeNewGame(false);
  } else if (i == 4) {
    currentScreen = CALC;
    drawCalc(3);
  } else if (i == 5) {
    fromHome = true;
    currentScreen = WIFI_LIST;
    wifiScanning = true;
    networkCount = 0;
    drawWifiList(3);
    scanWiFi();
    wifiScanning = false;
    drawWifiList(0);
  } else if (i == 6) {
    fromHome = true;
    currentScreen = WALL_PICK;
    drawWallPicker(3);
  } else if (i == 8) {
    currentScreen = NOTES_LIST;
    drawNotesList(3);
  } else if (i == 9) {
    clockTab = 0;
    clkLastSec = -1;
    clkLastMin = -1;
    currentScreen = CLOCK;
    drawClock(3);
  } else {
    currentScreen = SETTINGS;
    drawSettingsScreen(3);
  }
}

// =====================================================
void loop() {
  FT6336U_TouchPointType tp = ft6336u.scan();

  if (tp.touch_count > 0) {
    int tx = tp.tp[0].x;
    int ty = tp.tp[0].y;

    if (touching && sliderDrag && currentScreen == SETTINGS) applySliderTouch(tx);
    if (touching && currentScreen == GAME && snState == SN_PLAY) snakeSwipe(tx, ty);

    if (!touching) {
      touching = true;
      touchStartY = ty;
      touchLastY = ty;

      bool hasBack = (currentScreen != HOME && currentScreen != LOCK && currentScreen != GAME);

      if (hasBack && tx < 90 && ty < 50) {
        goBack();
      } else if (currentScreen == LOCK) {
        handleLockTouch(tx, ty);
      } else if (currentScreen == PIN_SET) {
        handlePinSetTouch(tx, ty);
      } else if (currentScreen == GAME) {
        if (tx < 90 && ty < 50) {
          goBack();
        } else {
          snSwipeX = tx;
          snSwipeY = ty;
          snakeTap();
        }
      } else if (currentScreen == HOME) {
        if (lockPin.length() > 0 && tx > 125 && tx < 195 && ty < 30) {
          lockNow();
        } else if (ty >= 130 && ty < 192) {
          openApp(0);                                   // weather widget
        } else if (ty >= 200 && ty < 380) {
          int col = tx / 80;
          int row = -1;
          if (ty < 288) row = 0;
          else if (ty >= 296) row = 1;
          if (row >= 0 && col >= 0 && col < 4) {
            int id = HOME_GRID[row * 4 + col];
            if (id >= 0) openApp(id);
          }
        } else if (ty >= 384 && ty < 470) {
          int i = (tx - 14) / 72;
          if (tx >= 14 && i >= 0 && i < 4) openApp(HOME_DOCK[i]);
        }
      } else if (currentScreen == SETTINGS) {
        if (ty > 78 && ty < 118) {
          sliderDrag = true;
          applySliderTouch(tx);
        } else if (ty >= 120 && ty < 162) {
          darkTheme = !darkTheme;
          applyTheme();
          saveSettings();
          drawSettingsScreen(0);
        } else if (ty >= 168 && ty < 210) {
          fromHome = false;
          currentScreen = WALL_PICK;
          drawWallPicker(1);
        } else if (ty >= 216 && ty < 258) {
          fromHome = false;
          currentScreen = WIFI_LIST;
          wifiScanning = true;
          networkCount = 0;
          drawWifiList(1);
          scanWiFi();
          wifiScanning = false;
          drawWifiList(0);
        } else if (ty >= 264 && ty < 306) {
          newPin = "";
          pinSetMsg = "";
          currentScreen = PIN_SET;
          drawPinSet(1);
        } else if (ty >= 312 && ty < 354) {
          useMetric = !useMetric;
          saveSettings();
          drawSettingsScreen(0);
        } else if (ty >= 360 && ty < 402) {
          locInput = "";
          locShift = false;
          locMsg = "";
          currentScreen = LOC_SEARCH;
          drawLocSearch(1);
        } else if (ty >= 408 && ty < 450) {
          openUpdate();
        }
      } else if (currentScreen == UPDATE) {
        handleUpdateTouch(tx, ty);
      } else if (currentScreen == WALL_PICK) {
        if (tx >= 8 && ty >= 64) {
          int c = (tx - 8) / 104, r = (ty - 64) / 174;
          if (c < 3 && r < 2 && ((tx - 8) % 104) < 96 && ((ty - 64) % 174) < 150) {
            wallIdx = r * 3 + c;
            preferences.putInt("wall", wallIdx);
            drawWallPicker(0);
          }
        }
      } else if (currentScreen == WIFI_LIST) {
        for (int i = 0; i < networkCount && i < 8; i++) {
          int itemY = 62 + i * 50;
          if (ty > itemY && ty < itemY + 44) {
            selectedNetwork = i;
            passwordInput = "";
            keyboardShift = false;
            currentScreen = WIFI_PASSWORD;
            drawPasswordScreen(1);
            break;
          }
        }
      } else if (currentScreen == WIFI_PASSWORD) {
        handlePasswordTouch(tx, ty);
      } else if (currentScreen == AI_CHAT) {
        handleAITouch(tx, ty);
      } else if (currentScreen == CALC) {
        handleCalcTouch(tx, ty);
      } else if (currentScreen == NOTES_LIST) {
        handleNotesListTouch(tx, ty);
      } else if (currentScreen == NOTE_EDIT) {
        handleNoteEditTouch(tx, ty);
      } else if (currentScreen == CLOCK) {
        handleClockTouch(tx, ty);
      } else if (currentScreen == WEATHER) {
        if (tx > 230 && ty < 50) fetchWeather(0);
      } else if (currentScreen == LOC_SEARCH) {
        handleLocSearchTouch(tx, ty);
      } else if (currentScreen == LOC_LIST) {
        handleLocListTouch(tx, ty);
      }
    }
    touchLastY = ty;
  } else {
    if (sliderDrag) {
      sliderDrag = false;
      saveSettings();
    }
    if (touching && currentScreen != LOCK && currentScreen != HOME && touchStartY > 420 && touchLastY < touchStartY - 60) {
      if (currentScreen == NOTE_EDIT) finishNote();
      fromHome = false;
      currentScreen = HOME;
      showAIKeyboard = false;
      drawHomeScreen(2);
    }
    touching = false;
    touchStartY = -1;
    touchLastY = -1;
  }

  // Timer finished? (waits while on the lock screen or in the game)
  if (timerRunning && (long)(millis() - timerEndMs) >= 0 && currentScreen != LOCK && currentScreen != GAME) {
    timerRunning = false;
    timerRemainMs = 0;
    timerDone = true;
    timerDoneAt = millis();
    timerFlash = true;
    timerLastFlash = millis();
    lastTimerSec = -1;
    if (currentScreen == NOTE_EDIT) finishNote();
    clockTab = 1;
    currentScreen = CLOCK;
    drawClock(3);
  }

  static unsigned long lastClockCheck = 0;
  static int lastMin = -1;
  if (millis() - lastClockCheck > 1000) {
    lastClockCheck = millis();
    if (currentScreen == HOME || currentScreen == LOCK) {
      struct tm ti;
      int m = getLocalTime(&ti, 0) ? ti.tm_min : -2;
      if (m != lastMin) {
        lastMin = m;
        if (currentScreen == HOME) drawHomeScreen(0);
        else drawLockScreen(0);
      }
    }
  }

  static unsigned long lastClkTick = 0;
  if (currentScreen == CLOCK && millis() - lastClkTick >= 100) {
    lastClkTick = millis();
    clockTick();
  }

  if (currentScreen == GAME) {
    snakeStep();
    delay(4);
  } else {
    delay(8);
  }
}

