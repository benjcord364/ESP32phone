bool searchLocations(const String& q) {
  locCount = 0;
  if (!wifiConnected) { locMsg = "No WiFi connection"; return false; }
  String name = q;
  name.trim();
  name.replace(" ", "%20");
  String url = "https://geocoding-api.open-meteo.com/v1/search?name=" + name + "&count=8&language=en&format=json";
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setTimeout(15000);
  http.begin(client, url);
  int code = http.GET();
  bool ok = false;
  if (code == 200) {
    String payload = http.getString();
    StaticJsonDocument<512> filter;
    filter["results"][0]["name"] = true;
    filter["results"][0]["latitude"] = true;
    filter["results"][0]["longitude"] = true;
    filter["results"][0]["admin1"] = true;
    filter["results"][0]["country_code"] = true;
    DynamicJsonDocument doc(6144);
    DeserializationError err = deserializeJson(doc, payload, DeserializationOption::Filter(filter));
    if (!err) {
      JsonArray arr = doc["results"].as<JsonArray>();
      for (JsonObject r : arr) {
        if (locCount >= 8) break;
        locName[locCount] = String((const char*)(r["name"] | ""));
        locAdmin[locCount] = String((const char*)(r["admin1"] | ""));
        locCountry[locCount] = String((const char*)(r["country_code"] | ""));
        locLat[locCount] = r["latitude"] | 0.0f;
        locLon[locCount] = r["longitude"] | 0.0f;
        locCount++;
      }
      ok = true;
      if (locCount == 0) locMsg = "No places found";
    } else locMsg = "Data error";
  } else if (code > 0) locMsg = "HTTP " + String(code);
  else locMsg = http.errorToString(code);
  http.end();
  return ok;
}

