// ICONS
void cloudShape(int cx, int cy, float f, uint16_t col) {
  gfx->fillCircle(cx - (int)(12 * f), cy + (int)(4 * f), (int)(9 * f), col);
  gfx->fillCircle(cx, cy - (int)(3 * f), (int)(13 * f), col);
  gfx->fillCircle(cx + (int)(13 * f), cy + (int)(3 * f), (int)(10 * f), col);
  gfx->fillRoundRect(cx - (int)(21 * f), cy + (int)(2 * f), (int)(43 * f), (int)(13 * f), (int)(6 * f), col);
}

void sunShape(int cx, int cy, float f, uint16_t col) {
  gfx->fillCircle(cx, cy, (int)(11 * f), col);
  int rr = (int)(2.2f * f);
  if (rr < 1) rr = 1;
  for (int k = 0; k < 8; k++) {
    float a = k * 0.7854f;
    gfx->fillCircle(cx + (int)(cosf(a) * 18 * f), cy + (int)(sinf(a) * 18 * f), rr, col);
  }
}

void sparkle(int cx, int cy, int R, uint16_t col) {
  int r = R * 28 / 100;
  if (r < 1) r = 1;
  gfx->fillTriangle(cx, cy - R, cx + r, cy, cx, cy + R, col);
  gfx->fillTriangle(cx, cy - R, cx - r, cy, cx, cy + R, col);
  gfx->fillTriangle(cx - R, cy, cx, cy - r, cx + R, cy, col);
  gfx->fillTriangle(cx - R, cy, cx, cy + r, cx + R, cy, col);
}

// ring segment between radii r0..r1 from angle d0 to d1 (degrees, 270 = straight up)
void arcRing(int cx, int cy, float r0, float r1, float d0, float d1, uint16_t col) {
  float step = 8.0f;
  for (float a = d0; a < d1; a += step) {
    float b = a + step;
    if (b > d1) b = d1;
    float ra = a * 0.0174533f, rb = b * 0.0174533f;
    int x0a = cx + (int)(cosf(ra) * r0), y0a = cy + (int)(sinf(ra) * r0);
    int x1a = cx + (int)(cosf(ra) * r1), y1a = cy + (int)(sinf(ra) * r1);
    int x0b = cx + (int)(cosf(rb) * r0), y0b = cy + (int)(sinf(rb) * r0);
    int x1b = cx + (int)(cosf(rb) * r1), y1b = cy + (int)(sinf(rb) * r1);
    gfx->fillTriangle(x0a, y0a, x1a, y1a, x1b, y1b, col);
    gfx->fillTriangle(x0a, y0a, x1b, y1b, x0b, y0b, col);
  }
}

void thickLine(int x0, int y0, int x1, int y1, int t, uint16_t col) {
  for (int o = -(t / 2); o <= t / 2; o++) {
    gfx->drawLine(x0 + o, y0, x1 + o, y1, col);
    gfx->drawLine(x0, y0 + o, x1, y1 + o, col);
  }
}

void drawWxIcon(int code, int cx, int cy, int size) {
  float f = size / 64.0f;
  uint16_t white = c565(255, 255, 255), gray = c565(214, 220, 228), sunC = c565(255, 205, 40);
  uint16_t dropC = c565(90, 170, 255), boltC = c565(255, 220, 60), snowC = c565(190, 225, 255);
  if (code == 0) {
    sunShape(cx, cy, f * 1.35f, sunC);
  } else if (code == 1 || code == 2) {
    sunShape(cx - (int)(10 * f), cy - (int)(10 * f), f, sunC);
    cloudShape(cx + (int)(4 * f), cy + (int)(8 * f), f, white);
  } else if (code == 3 || code == 45 || code == 48) {
    cloudShape(cx, cy - (int)(2 * f), f * 1.1f, gray);
    if (code != 3) {
      for (int i = 0; i < 3; i++)
        gfx->fillRoundRect(cx - (int)(22 * f), cy + (int)((16 + i * 6) * f), (int)(44 * f), (int)(3 * f) + 1, 1, gray);
    }
  } else if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) {
    cloudShape(cx, cy - (int)(8 * f), f, gray);
    int dw = (int)(3 * f);
    if (dw < 2) dw = 2;
    for (int i = 0; i < 3; i++)
      gfx->fillRoundRect(cx - (int)(14 * f) + i * (int)(12 * f), cy + (int)(12 * f), dw, (int)(10 * f), 1, dropC);
  } else if ((code >= 71 && code <= 77) || code == 85 || code == 86) {
    cloudShape(cx, cy - (int)(8 * f), f, gray);
    int dr = (int)(2.5f * f);
    if (dr < 1) dr = 1;
    for (int i = 0; i < 3; i++)
      gfx->fillCircle(cx - (int)(14 * f) + i * (int)(14 * f), cy + (int)((14 + (i % 2) * 6) * f), dr, snowC);
  } else {
    cloudShape(cx, cy - (int)(8 * f), f, c565(120, 128, 145));
    gfx->fillTriangle(cx + (int)(4 * f), cy + (int)(6 * f), cx - (int)(6 * f), cy + (int)(19 * f), cx + (int)(1 * f), cy + (int)(19 * f), boltC);
    gfx->fillTriangle(cx + (int)(1 * f), cy + (int)(15 * f), cx + (int)(9 * f), cy + (int)(15 * f), cx - (int)(3 * f), cy + (int)(28 * f), boltC);
  }
}

void drawTile(int x, int y, int s, const Col &top, const Col &bot) {
  int r = (int)(s * 0.23f);
  int bands = 10;
  for (int k = 0; k < bands; k++) {
    int y0 = k * s / bands, y1 = (k + 1) * s / bands;
    gfx->setClipRect(x, y + y0, s, y1 - y0 + 1);
    gfx->fillRoundRect(x, y, s, s, r, c565v(lerpCol(top, bot, (float)k / (bands - 1))));
  }
  gfx->clearClipRect();
}

