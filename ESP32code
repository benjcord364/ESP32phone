// NOTES
void saveNotes() {
  for (int i = 0; i < MAX_NOTES; i++) {
    String key = "n" + String(i);
    preferences.putString(key.c_str(), i < noteCount ? notes[i] : String(""));
  }
}

void loadNotes() {
  noteCount = 0;
  for (int i = 0; i < MAX_NOTES; i++) {
    String key = "n" + String(i);
    String s = preferences.getString(key.c_str(), "");
    if (s.length() > 0 && noteCount < MAX_NOTES) notes[noteCount++] = s;
  }
}

void removeNote(int idx) {
  if (idx < 0 || idx >= noteCount) return;
  for (int i = idx; i < noteCount - 1; i++) notes[i] = notes[i + 1];
  noteCount--;
  notes[noteCount] = "";
}

void finishNote() {
  if (curNote >= 0 && curNote < noteCount) {
    notes[curNote].trim();
    if (notes[curNote].length() == 0) removeNote(curNote);
  }
  curNote = -1;
  saveNotes();
}

